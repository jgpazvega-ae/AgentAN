# ─── WhatsApp / Meta ──────────────────────────────────────────────────────────
# Token permanente de acceso de tu app de Meta
WHATSAPP_TOKEN=tu_token_de_meta_aqui

# ID del número de teléfono de WhatsApp Business
# Lo encuentras en Meta for Developers → Tu App → WhatsApp → API Setup
WHATSAPP_PHONE_ID=tu_phone_id_aqui

# Token que TÚ inventas para verificar el webhook (cualquier string secreto)
WEBHOOK_VERIFY_TOKEN=mi_token_secreto_1234

# ─── Claude / Anthropic ───────────────────────────────────────────────────────
# Obtén tu clave en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar (puedes cambiarlo)
CLAUDE_MODEL=claude-sonnet-4-6

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=8000
DEBUG=false
