# Copia este archivo como .env y completa los valores.

# Nombre que aparece en la app y en los correos
COMPANY_NAME=Fletes Ejemplo

# Dirección pública de la página (se usa en los enlaces de los correos).
# En producción DEBE ser https:// para que funcionen la instalación y las notificaciones.
APP_URL=https://viajes.tuempresa.com
PORT=3000

# Carpeta donde se guardan la base de datos y las fotos (hacer respaldo de ella)
DATA_DIR=./data

# Zona horaria de la empresa
TZ_DISPLAY=America/Mexico_City

# Google Maps (Maps JavaScript API + Places API (New) + Geocoding API + Maps Embed API)
GOOGLE_MAPS_API_KEY=

# Correo saliente (SMTP). Ejemplo con Gmail: crea una "contraseña de aplicación"
# en tu cuenta de Google (requiere verificación en dos pasos).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
SMTP_FROM="Fletes Ejemplo <tucorreo@gmail.com>"

# Notificaciones push. Si se dejan vacías se generan solas y se guardan en la base de datos.
# Para generarlas manualmente: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@gmail.com
